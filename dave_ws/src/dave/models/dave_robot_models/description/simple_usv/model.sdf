<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="simple_usv">
    <pose>0 0 0 0 0 0</pose>
    <static>false</static>

    <link name="base_link">
      <inertial>
        <pose>0 0 0.05 0 0 0</pose>
        <mass>25.0</mass>
        <inertia>
          <ixx>1.5</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>4.0</iyy>
          <iyz>0</iyz>
          <izz>5.0</izz>
        </inertia>
      </inertial>

      <!-- Left hull -->
      <collision name="left_hull_collision">
        <pose>0 0.30 0 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>1.20</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="left_hull_visual">
        <pose>0 0.30 0 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>1.20</length>
          </cylinder>
        </geometry>
      </visual>

      <!-- Right hull -->
      <collision name="right_hull_collision">
        <pose>0 -0.30 0 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>1.20</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name="right_hull_visual">
        <pose>0 -0.30 0 0 1.5708 0</pose>
        <geometry>
          <cylinder>
            <radius>0.10</radius>
            <length>1.20</length>
          </cylinder>
        </geometry>
      </visual>

      <!-- Deck -->
      <collision name="deck_collision">
        <pose>0 0 0.10 0 0 0</pose>
        <geometry>
          <box>
            <size>0.9 0.55 0.08</size>
          </box>
        </geometry>
      </collision>

      <visual name="deck_visual">
        <pose>0 0 0.10 0 0 0</pose>
        <geometry>
          <box>
            <size>0.9 0.55 0.08</size>
          </box>
        </geometry>
      </visual>

      <!-- Simple buoyancy collision volume -->
      <collision name="buoyancy_collision">
        <pose>0 0 0.02 0 0 0</pose>
        <geometry>
          <box>
            <size>1.10 0.65 0.12</size>
          </box>
        </geometry>
      </collision>

      <!-- IMU -->
      <sensor name="imu_sensor" type="imu">
        <always_on>1</always_on>
        <update_rate>200.0</update_rate>
        <topic>/model/simple_usv/imu</topic>
      </sensor>
    </link>

    <!-- Camera mount -->
    <link name="camera_mount_link">
      <pose relative_to="base_link">0.20 0 0.28 0 0 0</pose>
      <inertial>
        <mass>0.0001</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0001</iyy>
          <iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
    </link>

    <joint name="camera_mount_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_mount_link</child>
    </joint>

    <!-- Camera link -->
    <link name="camera_link">
      <pose relative_to="camera_mount_link">0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.0001</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0001</iyy>
          <iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>

      <sensor name="front_camera" type="camera">
        <update_rate>30</update_rate>
        <visualize>true</visualize>
        <always_on>1</always_on>
        <topic>/model/simple_usv/camera</topic>
        <camera>
          <horizontal_fov>1.05</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>50.0</far>
          </clip>
        </camera>
      </sensor>
    </link>

    <joint name="camera_joint" type="fixed">
      <parent>camera_mount_link</parent>
      <child>camera_link</child>
    </joint>

    <!-- Left thruster -->
    <link name="thruster_left">
      <pose>-0.45 0.30 0 0 1.5708 0</pose>
      <visual name="thruster_left_visual">
        <geometry>
          <cylinder>
            <radius>0.04</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>
      </visual>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.001</iyy>
          <iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
    </link>

    <joint name="thruster_left_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster_left</child>
      <axis>
        <xyz>0 0 -1</xyz>
      </axis>
    </joint>

    <!-- Right thruster -->
    <link name="thruster_right">
      <pose>-0.45 -0.30 0 0 1.5708 0</pose>
      <visual name="thruster_right_visual">
        <geometry>
          <cylinder>
            <radius>0.04</radius>
            <length>0.10</length>
          </cylinder>
        </geometry>
      </visual>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>0.001</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.001</iyy>
          <iyz>0</iyz>
          <izz>0.001</izz>
        </inertia>
      </inertial>
    </link>

    <joint name="thruster_right_joint" type="revolute">
      <parent>base_link</parent>
      <child>thruster_right</child>
      <axis>
        <xyz>0 0 -1</xyz>
      </axis>
    </joint>

    <!-- Hydrodynamics -->
    <plugin
      filename="gz-sim-hydrodynamics-system"
      name="gz::sim::systems::Hydrodynamics">
      <link_name>base_link</link_name>
      <water_density>1000.0</water_density>

      <!-- Added mass -->
      <xDotU>0</xDotU>
      <yDotV>0</yDotV>
      <zDotW>0</zDotW>
      <kDotP>0</kDotP>
      <mDotQ>0</mDotQ>
      <nDotR>0</nDotR>

      <!-- Linear drag -->
      <xU>-8.0</xU>
      <yV>-20.0</yV>
      <zW>-30.0</zW>
      <kP>-2.0</kP>
      <mQ>-2.0</mQ>
      <nR>-8.0</nR>

      <!-- Quadratic drag -->
      <xUabsU>-20.0</xUabsU>
      <yVabsV>-40.0</yVabsV>
      <zWabsW>-60.0</zWabsW>
      <kPabsP>-3.0</kPabsP>
      <mQabsQ>-3.0</mQabsQ>
      <nRabsR>-10.0</nRabsR>
    </plugin>

    <!-- Thrusters -->
    <plugin
      filename="gz-sim-thruster-system"
      name="gz::sim::systems::Thruster">
      <namespace>simple_usv</namespace>
      <joint_name>thruster_left_joint</joint_name>
      <thrust_coefficient>0.02</thrust_coefficient>
      <fluid_density>1000.0</fluid_density>
      <propeller_diameter>0.1</propeller_diameter>
      <velocity_control>true</velocity_control>
      <use_angvel_cmd>False</use_angvel_cmd>
    </plugin>

    <plugin
      filename="gz-sim-thruster-system"
      name="gz::sim::systems::Thruster">
      <namespace>simple_usv</namespace>
      <joint_name>thruster_right_joint</joint_name>
      <thrust_coefficient>-0.02</thrust_coefficient>
      <fluid_density>1000.0</fluid_density>
      <propeller_diameter>0.1</propeller_diameter>
      <velocity_control>true</velocity_control>
      <use_angvel_cmd>False</use_angvel_cmd>
    </plugin>

    <!-- Odometry -->
    <plugin
      filename="gz-sim-odometry-publisher-system"
      name="gz::sim::systems::OdometryPublisher">
      <odom_frame>map</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <dimensions>3</dimensions>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

    <!-- Joint states -->
    <plugin
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">
    </plugin>

    <!-- IMU system -->
    <plugin
      filename="gz-sim-imu-system"
      name="gz::sim::systems::Imu">
    </plugin>

  </model>
</sdf>