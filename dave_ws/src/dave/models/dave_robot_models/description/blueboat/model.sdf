<?xml version='1.0' encoding='UTF-8'?>
<sdf version="1.9">
  <model name="blueboat">
    
    
    <link name="base_link">
      <inertial>
        <pose>0.02 0 -0.3 0 0 0</pose>
        <mass>15.0</mass>
        <inertia>
          <ixx>5.345</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>5.064</iyy>
          <iyz>0</iyz>
          <izz>2.881</izz>
        </inertia>
      </inertial>

